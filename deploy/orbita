#!/usr/bin/env bash
# Орбита — серверный режим StarsCenter: работа 24/7 и обновление на ходу.
#
#   sudo orbita install            первая установка на чистый Ubuntu 22.04/24.04 / Debian 12
#   sudo orbita deploy [ветка|sha]  собрать релиз и обновиться без остановки ботов (откат сам при сбое)
#   sudo orbita rollback [релиз]   вернуться на прошлый (или указанный) релиз так же на ходу
#   sudo orbita auto               для таймера: обновиться, если в ветке новый коммит (ORBITA_AUTO=1)
#   sudo orbita import ФАЙЛ        перенести данные с ПК (файл из center/migrate.py export)
#        orbita status | releases | logs [бот] | token
#
# Где что лежит: код /opt/orbita/releases/<время>-<sha> (+ ссылка current), данные /var/lib/orbita
# (CENTER_HOME), копии баз перед каждым обновлением /var/backups/orbita, настройки /etc/orbita/orbita.env.
set -Eeuo pipefail

BASE=${ORBITA_BASE:-/opt/orbita}
DATA=${CENTER_HOME:-/var/lib/orbita}
BACKUPS=${ORBITA_BACKUPS:-/var/backups/orbita}
ETC=${ORBITA_ETC:-/etc/orbita}
ENV_FILE=$ETC/orbita.env
SERVICE=orbita-center
USER_NAME=orbita
NODE_VERSION=${ORBITA_NODE_VERSION:-22.12.0}
KEEP_RELEASES=${ORBITA_KEEP_RELEASES:-6}
KEEP_BACKUPS=${ORBITA_KEEP_BACKUPS:-15}

[[ -f $ENV_FILE ]] && set -a && . "$ENV_FILE" && set +a
BRANCH=${ORBITA_BRANCH:-claude/merge-bots-into-center-yozwsy}
REPO_URL=${ORBITA_REPO:-git@github.com:Freak-ii/p2p-liskins-steam-funpay.git}
export CENTER_HOME=$DATA

say()  { printf '\033[1;36m[орбита]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[орбита]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[орбита]\033[0m %s\n' "$*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "нужен root: sudo orbita $*"; }
notify() {  # в журнал systemd; критичное центр и так шлёт в Telegram
  logger -t orbita -- "$*" 2>/dev/null || true
}

current_release() { readlink -f "$BASE/current" 2>/dev/null || true; }
py_of() { echo "$1/.venv/bin/python"; }
ctl() { local rel; rel=$(current_release); [[ -n $rel ]] || die "нет текущего релиза"; ( cd "$rel" && "$(py_of "$rel")" -m center.serverctl "$@" ); }
ctl_with() { local rel=$1; shift; ( cd "$rel" && "$(py_of "$rel")" -m center.serverctl "$@" ); }

lock() {
  exec 9>"$BASE/.lock"
  flock -n 9 || die "уже идёт другое обновление"
}

# ---------------------------------------------------------------- сборка релиза
fetch() {
  local repo=$BASE/repo
  if [[ ! -d $repo/.git ]]; then
    say "клонирую $REPO_URL"
    GIT_SSH_COMMAND="ssh -i $ETC/deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new" \
      git clone --filter=blob:none --no-checkout "$REPO_URL" "$repo" >/dev/null
  fi
  GIT_SSH_COMMAND="ssh -i $ETC/deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new" \
    git -C "$repo" fetch --quiet --prune origin "+refs/heads/*:refs/remotes/origin/*"
}

resolve() {  # ветка или sha → полный sha
  local ref=${1:-$BRANCH}
  git -C "$BASE/repo" rev-parse --verify --quiet "origin/$ref^{commit}" \
    || git -C "$BASE/repo" rev-parse --verify --quiet "$ref^{commit}" \
    || die "не найден коммит или ветка: $ref"
}

ensure_node() {
  local dir=$BASE/runtime/node-v$NODE_VERSION
  if [[ ! -x $dir/bin/node ]]; then
    local arch; arch=$(uname -m); [[ $arch == x86_64 ]] && arch=x64; [[ $arch == aarch64 ]] && arch=arm64
    local name=node-v$NODE_VERSION-linux-$arch
    say "ставлю Node.js $NODE_VERSION"
    local tmp; tmp=$(mktemp -d)
    curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/$name.tar.xz" -o "$tmp/node.tar.xz"
    curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt" -o "$tmp/SHASUMS256.txt"
    ( cd "$tmp" && grep " $name.tar.xz\$" SHASUMS256.txt | sed "s/$name.tar.xz/node.tar.xz/" | sha256sum -c --quiet ) \
      || die "контрольная сумма Node.js не совпала"
    mkdir -p "$BASE/runtime" && tar -xJf "$tmp/node.tar.xz" -C "$BASE/runtime" && mv "$BASE/runtime/$name" "$dir"
    rm -rf "$tmp"
  fi
  ln -sfn "$dir" "$BASE/runtime/node"
}

build() {  # sha → путь нового релиза
  local sha=$1 short=${1:0:9} rel
  rel=$BASE/releases/$(date +%Y%m%d-%H%M%S)-$short
  say "сборка релиза $(basename "$rel")"
  mkdir -p "$rel"
  git -C "$BASE/repo" archive "$sha" | tar -x -C "$rel"
  local subject; subject=$(git -C "$BASE/repo" log -1 --format=%s "$sha")
  python3 - "$rel/RELEASE.json" "$sha" "$BRANCH" "$subject" <<'PY'
import json, sys, time
path, sha, branch, subject = sys.argv[1:]
json.dump({"sha": sha, "branch": branch, "subject": subject, "built_at": time.time()}, open(path, "w"), ensure_ascii=False)
PY
  # Python-зависимости: одно окружение на набор requirements — повторные релизы собираются за секунды
  local reqhash; reqhash=$(cat "$rel"/requirements.txt "$rel"/bots/*/requirements.txt 2>/dev/null | { cat; python3 -V; } | sha256sum | cut -c1-16)
  local venv=$BASE/venvs/$reqhash
  if [[ ! -x $venv/bin/python ]]; then
    say "новые Python-зависимости → окружение $reqhash"
    rm -rf "$venv.tmp"; python3 -m venv "$venv.tmp"
    "$venv.tmp/bin/pip" install --quiet --upgrade pip
    ( cd "$rel" && "$venv.tmp/bin/pip" install --quiet -r requirements.txt pytest )
    mv "$venv.tmp" "$venv"
  fi
  ln -sfn "$venv" "$rel/.venv"
  # LisBot: node_modules по package-lock
  if [[ -f $rel/bots/lisbot/package-lock.json ]]; then
    ensure_node
    local lockhash; lockhash=$(sha256sum "$rel/bots/lisbot/package-lock.json" | cut -c1-16)
    local nm=$BASE/node_modules/$lockhash
    if [[ ! -d $nm/node_modules ]]; then
      say "новые зависимости LisBot → $lockhash"
      rm -rf "$nm.tmp"; mkdir -p "$nm.tmp"
      cp "$rel/bots/lisbot/package.json" "$rel/bots/lisbot/package-lock.json" "$nm.tmp/"
      ( cd "$nm.tmp" && PATH="$BASE/runtime/node/bin:$PATH" npm ci --omit=dev --no-audit --no-fund --loglevel=error >&2 )
      mv "$nm.tmp" "$nm"
    fi
    ln -sfn "$nm/node_modules" "$rel/bots/lisbot/node_modules"
  fi
  "$(py_of "$rel")" -m compileall -q "$rel/center" "$rel/bots" >/dev/null || die "ошибка компиляции в релизе"
  chown -R root:"$USER_NAME" "$rel"; chmod -R g+rX,o-rwx "$rel"
  echo "$rel"
}

smoke() {  # проверка релиза до переключения: импорт центра и всех ботов, быстрые тесты
  local rel=$1 py; py=$(py_of "$rel")
  say "проверка релиза"
  ( cd "$rel" && "$py" -c "import center.app, center.web, center.rollout, center.serverctl" ) || return 1
  local b
  for b in mannbot starsbot shopbot; do
    [[ -d $rel/bots/$b/$b ]] || continue
    ( cd "$rel/bots/$b" && PYTHONPATH=. "$py" -c "import $b" ) || { warn "не импортируется $b"; return 1; }
  done
  if [[ ${ORBITA_TESTS:-quick} != off ]]; then
    local tests="tests/test_workers.py tests/test_rollout.py tests/test_config.py"
    [[ ${ORBITA_TESTS:-quick} == full ]] && tests=tests
    ( cd "$rel" && CENTER_SERVER= timeout 600 "$py" -m pytest -q -x -p no:cacheprovider $tests >/tmp/orbita-tests.log 2>&1 ) \
      || { warn "тесты не прошли (см. /tmp/orbita-tests.log)"; tail -20 /tmp/orbita-tests.log >&2; return 1; }
  fi
}

snapshot() {
  local dest=$BACKUPS/$(date +%Y%m%d-%H%M%S)-$1
  mkdir -p "$dest"; chmod 700 "$BACKUPS" "$dest"
  ctl_with "$2" snapshot "$dest" >/dev/null || warn "копии баз сняты не полностью"
  cp -a "$DATA"/*.yaml "$dest/" 2>/dev/null || true
  ls -1dt "$BACKUPS"/*/ 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | xargs -r rm -rf
  echo "$dest"
}

switch_current() {  # атомарная смена ссылки current
  ln -sfn "$1" "$BASE/current.new" && mv -Tf "$BASE/current.new" "$BASE/current"
  ln -sfn "$BASE/current/deploy/orbita" /usr/local/bin/orbita
}

# ---------------------------------------------------------------- эстафета: новая версия без остановки ботов
go_live() {  # $1 — новый релиз, $2 — прежний; вернуть 0, если новый работает
  local new=$1 old=$2 reason=${3:-обновление}
  local active=0; systemctl is-active --quiet "$SERVICE" && active=1
  switch_current "$new"
  if (( active )); then
    mkdir -p "$DATA/server" && chown "$USER_NAME:$USER_NAME" "$DATA/server"
    printf '{"reason": "%s", "from": "%s"}\n' "$reason" "$(basename "$old")" >"$DATA/server/rollout-pending.json"
    chown "$USER_NAME:$USER_NAME" "$DATA/server/rollout-pending.json"
    local rc=0; ctl_with "$new" handover >&2 || rc=$?
    if (( rc == 3 || rc == 2 )); then
      warn "работающий центр не умеет передавать эстафету — обычный перезапуск: боты остановятся,"
      warn "запустите их кнопкой «Запустить» (центр сам ботов не запускает)"
      rm -f "$DATA/server/rollout-pending.json"
      systemctl restart "$SERVICE"
      ctl_with "$new" wait-up 90 || { warn "новый центр не отвечает"; return 1; }
      return 0
    elif (( rc != 0 )); then
      rm -f "$DATA/server/rollout-pending.json"; switch_current "$old"; return 1
    fi
  else
    systemctl start "$SERVICE"
    ctl_with "$new" wait-up 90 || { warn "новый центр не отвечает"; return 1; }
    return 0
  fi
  ctl_with "$new" wait-up 90 || { warn "новый центр не отвечает"; return 1; }
  say "центр работает на $(basename "$new"); обновляю ботов по одному"
  ctl_with "$new" wait-rollout 1200 >&2
}

rollback_to() {  # вернуть центр на релиз $1 (боты при сбое уже откачены центром)
  local target=$1 bad=$2
  warn "откат на $(basename "$target")"
  notify "откат: $(basename "$bad") → $(basename "$target")"
  if ! go_live "$target" "$bad" "откат"; then
    warn "откат тоже не прошёл гладко — проверьте: orbita status, orbita logs"
    return 1
  fi
}

cmd_deploy() {
  need_root deploy; lock
  local prev; prev=$(current_release)
  fetch
  local sha; sha=$(resolve "${1:-}")
  if [[ -n $prev && -f $prev/RELEASE.json ]] && grep -q "\"$sha\"" "$prev/RELEASE.json" && [[ ${FORCE:-0} != 1 ]]; then
    say "уже на ${sha:0:9}"; return 0
  fi
  local rel; rel=$(build "$sha" | tail -1)
  if ! smoke "$rel"; then
    notify "релиз ${sha:0:9} не прошёл проверку — не установлен"
    rm -rf "$rel"; die "релиз ${sha:0:9} не прошёл проверку, система не тронута"
  fi
  [[ -n $prev ]] && say "копии баз: $(snapshot "${sha:0:9}" "$prev")"
  if go_live "$rel" "${prev:-$rel}" "обновление до ${sha:0:9}"; then
    say "готово: $(basename "$rel")"; notify "обновлено до ${sha:0:9}"
    prune
  else
    [[ -n $prev && $prev != "$rel" ]] && rollback_to "$prev" "$rel"
    die "обновление до ${sha:0:9} не прошло, система на $(basename "$(current_release)")"
  fi
}

cmd_rollback() {
  need_root rollback; lock
  local cur target; cur=$(current_release)
  if [[ -n ${1:-} ]]; then target=$BASE/releases/$1; else
    # самый новый релиз старше текущего, иначе самый новый из остальных
    target=$(ls -1d "$BASE"/releases/*/ | sed 's:/$::' | sort | awk -v c="$cur" '$0 < c' | tail -1)
    [[ -n $target ]] || target=$(ls -1d "$BASE"/releases/*/ | sed 's:/$::' | grep -vxF "$cur" | sort | tail -1)
  fi
  [[ -d $target ]] || die "нет релиза для отката"
  go_live "$target" "$cur" "ручной откат" || die "откат не прошёл"
  say "работает $(basename "$target")"
}

cmd_auto() {
  [[ ${ORBITA_AUTO:-1} == 1 && ! -f $ETC/auto-off ]] || { say "автообновление выключено"; return 0; }
  cmd_deploy "$BRANCH"
}

prune() {
  local cur; cur=$(current_release)
  ls -1d "$BASE"/releases/*/ 2>/dev/null | sed 's:/$::' | sort | head -n -"$KEEP_RELEASES" | grep -vxF "$cur" | xargs -r rm -rf
  # окружения и node_modules, на которые не ссылается ни один релиз
  local used; used=$(for r in "$BASE"/releases/*; do readlink -f "$r/.venv"; readlink -f "$r/bots/lisbot/node_modules" | xargs -r dirname; done 2>/dev/null)
  for d in "$BASE"/venvs/* "$BASE"/node_modules/*; do [[ -d $d ]] && ! grep -qxF "$d" <<<"$used" && rm -rf "$d"; done
  true
}

# ---------------------------------------------------------------- установка
cmd_install() {
  need_root install
  . /etc/os-release
  say "установка Орбиты на $PRETTY_NAME"
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git python3 python3-venv python3-pip curl xz-utils \
    ca-certificates sqlite3 build-essential >/dev/null
  id "$USER_NAME" >/dev/null 2>&1 || useradd --system --home-dir "$DATA" --shell /usr/sbin/nologin "$USER_NAME"
  mkdir -p "$BASE/releases" "$BASE/venvs" "$BASE/node_modules" "$DATA" "$BACKUPS" "$ETC"
  chown "$USER_NAME:$USER_NAME" "$DATA"; chmod 700 "$DATA" "$BACKUPS" "$ETC"
  if [[ ! -f $ENV_FILE ]]; then
    umask 077
    cat >"$ENV_FILE" <<EOF
# Орбита: настройки сервера (права 600, только root). Ключ ниже шифрует secrets.dat — сохраните его в надёжном месте:
# без него ключи в хранилище не расшифровать.
CENTER_SECRET_KEY=$(head -c 32 /dev/urandom | base64 | tr -d '=+/' | cut -c1-40)
ORBITA_REPO=$REPO_URL
ORBITA_BRANCH=$BRANCH
# 1 — сам обновляться при новом коммите в ветке (таймер раз в 5 минут), 0 — только вручную
ORBITA_AUTO=1
# сколько секунд бот должен проработать на новом коде без падений, прежде чем обновлять следующего
ORBITA_VERIFY_SECONDS=45
# quick | full | off — тесты релиза перед установкой
ORBITA_TESTS=quick
CENTER_NODE=$BASE/runtime/node/bin/node
TZ=Europe/Moscow
EOF
    say "создан $ENV_FILE (в нём ключ шифрования секретов)"
  fi
  if [[ ! -f $ETC/deploy_key ]]; then
    ssh-keygen -q -t ed25519 -N "" -C "orbita@$(hostname)" -f "$ETC/deploy_key"
  fi
  local src; src=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
  install -m 644 "$src/systemd/orbita-center.service" "$src/systemd/orbita-update.service" \
    "$src/systemd/orbita-update.timer" /etc/systemd/system/
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null
  if ! GIT_SSH_COMMAND="ssh -i $ETC/deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new" \
       git ls-remote "$REPO_URL" >/dev/null 2>&1; then
    say "добавьте ключ доступа к репозиторию (GitHub → репозиторий → Settings → Deploy keys → Add, только чтение):"
    echo; cat "$ETC/deploy_key.pub"; echo
    say "потом запустите: sudo $0 deploy"
    return 0
  fi
  cmd_deploy
  systemctl enable --now orbita-update.timer >/dev/null
  say "готово. Панель: ssh -L 8800:127.0.0.1:8800 root@сервер, затем http://127.0.0.1:8800 (вход: orbita token)"
  say "Боты сами не запускаются — нажмите «Запустить» в панели (правило центра)."
}

cmd_import() {
  need_root import
  [[ -f ${1:-} ]] || die "укажите файл: orbita import /root/orbita.bundle"
  if systemctl is-active --quiet "$SERVICE"; then
    say "останавливаю центр на время переноса"; systemctl stop "$SERVICE"
  fi
  local rel; rel=$(current_release); [[ -n $rel ]] || die "сначала orbita deploy"
  ( cd "$rel" && "$(py_of "$rel")" -m center.migrate import "$1" --home "$DATA" ${FORCE:+--force} )
  chown -R "$USER_NAME:$USER_NAME" "$DATA"
  systemctl start "$SERVICE"
  say "данные перенесены, центр запущен. Боты не запущены — проверьте настройки и запустите их в панели."
  warn "Убедитесь, что на ПК центр закрыт и боты выключены: два экземпляра на одном FunPay/TON недопустимы."
}

cmd_status() {
  systemctl --no-pager --lines=0 status "$SERVICE" 2>/dev/null | head -5 || true
  echo "релиз: $(basename "$(current_release)")"
  ctl status 2>/dev/null || echo "центр не отвечает"
}

cmd_releases() {
  local cur; cur=$(current_release)
  for r in $(ls -1d "$BASE"/releases/*/ 2>/dev/null | sed 's:/$::' | sort); do
    local mark=" "; [[ $r == "$cur" ]] && mark="*"
    printf '%s %s  %s\n' "$mark" "$(basename "$r")" "$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("subject",""))' "$r/RELEASE.json" 2>/dev/null)"
  done
}

cmd_logs() {
  local f=$DATA/logs/${1:-center}.log
  [[ -f $f ]] || die "нет журнала $f (боты: starsbot mannbot lisbot shopbot tggift)"
  tail -n 200 -F "$f"
}

cmd_token() {
  python3 -c 'import yaml,sys;print((yaml.safe_load(open(sys.argv[1])) or {}).get("center",{}).get("token",""))' "$DATA/center.yaml" 2>/dev/null \
    || grep -A3 '^center:' "$DATA/center.yaml" | grep token
}

case ${1:-help} in
  install)  shift; cmd_install "$@" ;;
  deploy)   shift; cmd_deploy "$@" ;;
  rollback) shift; cmd_rollback "$@" ;;
  auto)     shift; cmd_auto "$@" ;;
  import)   shift; cmd_import "$@" ;;
  status)   cmd_status ;;
  releases) cmd_releases ;;
  logs)     shift; cmd_logs "$@" ;;
  token)    cmd_token ;;
  lib)      : ;;   # source deploy/orbita lib — только функции (для проверки)
  *) sed -n "2,13p" "${BASH_SOURCE[0]}" | sed "s/^# \{0,1\}//" ;;
esac
