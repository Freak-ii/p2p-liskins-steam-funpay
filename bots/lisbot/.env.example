# --- LIS-SKINS ---
# Ключ API: lis-skins.com -> Профиль -> API
LIS_API_KEY=

# --- Market.CSGO (режим арбитража) ---
# Ключ: market.csgo.com -> API -> Создать ключ. Вывести деньги этим ключом нельзя.
MARKET_CSGO_API_KEY=

# --- Steam ---
STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=
# Из maFile (Steam Desktop Authenticator) — нужны для входа и подтверждения лотов
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=
# Ваша трейд-ссылка: https://steamcommunity.com/tradeoffer/new/?partner=XXXX&token=YYYY
STEAM_TRADE_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Веб-панель (обязательно смените) ---
DASHBOARD_TOKEN=change-me-to-long-random-string
